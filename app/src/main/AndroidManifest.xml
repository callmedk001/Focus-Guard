<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ========================================================================= -->
    <!-- FUTURE PHASE PERMISSIONS ARCHITECTURE                                      -->
    <!-- Declared for architectural readiness in future phases without active       -->
    <!-- background interception logic in Phase 1 foundation.                       -->
    <!-- ========================================================================= -->

    <!-- Detect distracting app launches (UsageStatsManager) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Display blocking overlay dialog when a distraction is intercepted -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service support for persistent guard daemon in future phases -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Android 13+ notifications for focus alerts and status updates -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Auto-start protection service after device restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Prevent system from killing the protection process during focus sessions -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Biometric Authentication (Phase 4 Security Engine) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <application
        android:name=".FocusGuardApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DKFocusGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DKFocusGuard"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- YouTube Shorts Interruption Overlay Activity (Phase 6) -->
        <activity
            android:name=".ui.interruption.ShortsInterruptionActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DKFocusGuard"
            android:excludeFromRecents="true" />

        <!-- Focus Guard Accessibility Detection Service (Phase 5) -->
        <service
            android:name=".services.accessibility.FocusGuardAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="@string/accessibility_service_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Focus Guard Local VPN DNS Protection Service (Phase 8) -->
        <service
            android:name=".services.vpn.FocusGuardVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Focus Guard Focus Schedule Alarm Receiver (Phase 9) -->
        <receiver
            android:name=".receivers.ScheduleAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.dk.focusguard.action.SCHEDULE_TRANSITION" />
            </intent-filter>
        </receiver>

        <!-- Focus Guard Device Restart & Service Recovery Receiver (Phase 9) -->
        <receiver
            android:name=".receivers.BootRecoveryReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>

